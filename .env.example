# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000

# ─── Frontend (Next.js) ────────────────────────────────────────────────────────
# Public — safe to expose to the browser. Points to the Express API.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/youtube_content_studio

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (Better Auth) ────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-better-auth-secret-here
BETTER_AUTH_URL=http://localhost:3001

# ─── Google / YouTube OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# YouTube Data API v3 key (server-side, non-OAuth requests)
YOUTUBE_API_KEY=your-youtube-api-key

# ─── AI — Text ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── AI — Image ────────────────────────────────────────────────────────────────
# OpenAI DALL-E 3 uses OPENAI_API_KEY above

# ─── AI — Video ────────────────────────────────────────────────────────────────
RUNWAY_API_KEY=your-runway-api-key

# ─── AI — Audio / Voiceover ────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ─── Storage (Cloudflare R2 / S3-compatible) ───────────────────────────────────
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=youtube-content-studio
R2_PUBLIC_URL=https://your-bucket.r2.dev

# ─── Encryption ────────────────────────────────────────────────────────────────
# 32-byte hex string — used to encrypt YouTube OAuth tokens at rest
ENCRYPTION_KEY=your-32-byte-hex-encryption-key
